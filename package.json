{
  "name": "gm-boutique",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "shared"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@gm-boutique/api",
    "dev:web": "npm run dev --workspace=@gm-boutique/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm run build --workspaces",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,vue,json,md}\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
